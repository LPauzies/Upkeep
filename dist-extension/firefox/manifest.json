{
  "manifest_version": 3,
  "name": "Upkeep",
  "short_name": "Upkeep",
  "version": "1.0.0",
  "description": "Client-side UI overhaul for endstep.cc/game/*: dual live graveyards (opponent & yours), horizontal midline phase bar, docked game log, and crisp Helvetica typography without touching Magic cards.",
  "homepage_url": "https://github.com/LPauzies/Upkeep",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://endstep.cc/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "upkeep@lpauzies.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Upkeep — Endstep UI Settings",
    "default_popup": "src/popup/popup.html",
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://endstep.cc/*"
      ],
      "js": [
        "src/content/ws-spy.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://endstep.cc/*"
      ],
      "css": [
        "src/content/upkeep.css"
      ],
      "js": [
        "src/content/upkeep.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
