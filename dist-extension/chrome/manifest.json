{
  "manifest_version": 3,
  "name": "Upkeep",
  "short_name": "Upkeep",
  "version": "1.0.2",
  "description": "Surcharge CSS/JS côté client pour endstep.cc/game/* : cimetière adverse en continu, compteurs PV/Deck/Main haute lisibilité et journal ouvert à gauche, sans modifier les cartes.",
  "homepage_url": "https://github.com/LPauzies/Upkeep",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://endstep.cc/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Upkeep — Refonte UI Endstep",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://endstep.cc/*"
      ],
      "css": [
        "src/content/upkeep.css"
      ],
      "js": [
        "src/content/upkeep.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
